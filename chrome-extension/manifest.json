{
  "manifest_version": 3,
  "name": "BookExport",
  "version": "0.3.0",
  "description": "Export books from WeRead as EPUB files.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BookExport",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://weread.qq.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.weread.qq.com/*",
    "https://*.tencent-cloud.com/*",
    "https://*.myqcloud.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.js", "popup.css", "lib/epub-export.js"],
      "matches": ["https://weread.qq.com/*"]
    }
  ]
}
