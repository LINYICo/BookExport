{
    "name": "bookexport",
    "version": "0.4.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "node scripts/build.ts --watch",
        "build": "node scripts/build.ts --release",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint src tests scripts rolldown.config.ts",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
        "test": "node --test tests/unit/*.test.ts",
        "test:chrome": "node tests/chrome.test.ts",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:chrome",
        "release": "pnpm build && node scripts/release.ts"
    },
    "devDependencies": {
        "@types/chrome": "latest",
        "@types/node": "latest",
        "oxfmt": "latest",
        "oxlint": "latest",
        "rolldown": "latest",
        "typescript": "latest"
    }
}
